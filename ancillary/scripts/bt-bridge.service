[Unit]
Description=bt-bridge Bluetooth to DirectConnect bridge
After=bluetooth.target network-online.target
Wants=bluetooth.target network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/bt-bridge --reconnect --wait-for-devices --device %DEVICE_LIST%
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target